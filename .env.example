# ─────────────────────────────────────────────────────────────────────────────
# Study Assistant Hub — environment configuration
#
# Copy this file to `.env` and fill in the values. EVERY value the app needs is
# declared here; the code reads NOTHING that is not provided through these
# variables (the single config layer is backend/config.py + frontend/assets/config.js).
#
# Required values have NO in-code fallback — the server refuses to start and prints
# exactly what is missing (e.g. "❌ Missing/invalid configuration: PORT") until set.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Runtime ----
# Environment mode: "development" or "production".
#   development → auto-reload on, verbose logs
#   production  → auto-reload off
# Switching environments requires ONLY changing this value — no code changes.
APP_ENV=development

# Address and port the server binds to. No defaults exist in code — set them here.
HOST=127.0.0.1
PORT=8000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---- Frontend / CORS ----
# The SPA is served by THIS server (same origin), so no CORS is needed and this is
# left empty. If you run the SPA on a different origin (see FRONTEND_PORT below), list the
# allowed origin(s) here, comma-separated, e.g.:
#   CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=

# ---- Split-origin frontend (optional) ----
# By default ONE server serves BOTH the SPA and the API on PORT (same origin, no CORS).
# To run the FRONTEND on its OWN port, set FRONTEND_PORT: `python run.py` then also serves
# the static SPA there, while the browser calls the API cross-origin at API_BASE_URL.
# Leave FRONTEND_PORT blank for classic single-server mode.
#
# When FRONTEND_PORT is set you MUST also set API_BASE_URL (the absolute API URL the browser
# uses) and add the SPA's origin to CORS_ORIGINS above. Example local split setup:
#   PORT=8000
#   FRONTEND_PORT=5173
#   API_BASE_URL=http://127.0.0.1:8000/api
#   CORS_ORIGINS=http://127.0.0.1:5173
FRONTEND_PORT=
API_BASE_URL=

# ---- LLM provider ----
# Which provider to use. Supported (a client integration exists): groq.
# The selected provider comes ONLY from here — it is never hardcoded.
LLM_PROVIDER=groq

# Groq API key — get a free one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# ---- Auth (optional, Clerk) ----
# Leave BLANK to run the app open (no sign-in). Set a Clerk Publishable Key to put
# a beautiful sign-in gate in front of the app — after signing in, the full Study
# Assistant Hub appears. The publishable key is PUBLIC (safe in the browser); the SPA
# reads it via GET /api/config. Get one at https://dashboard.clerk.com/last-active?path=api-keys
CLERK_PUBLISHABLE_KEY=
# Optional: reserved for backend API session-token verification (defense-in-depth).
# Without it, the gate is client-side only. Keep this SECRET — never expose it.
CLERK_SECRET_KEY=

# ---- Persistence (optional, MongoDB) ----
# Leave BLANK to run without history (the app works exactly the same, nothing saved).
# Set a MongoDB connection string to save & browse every chat, quiz, flashcard deck,
# study plan and mind map. History is scoped per user: when Clerk auth is on, each
# signed-in user only sees their own items; without Clerk, everything is stored under
# a single "local" profile. Keep this SECRET (it contains DB credentials).
MONGODB_URI=
# Database name to use inside the cluster (created automatically on first write).
MONGODB_DB_NAME=study_assistant_hub

# ---- Guest accounts (anonymous) ----
# When MongoDB persistence is on AND a Clerk key is set, the sign-in gate also offers
# "Continue as guest": an anonymous, MongoDB-backed session whose chats, quizzes,
# flashcards, plans and mind maps are saved just like a signed-in user's. If the guest
# later signs in/up with Clerk, all their data is migrated to that account automatically.
# Guests need a database, so this turns on/off purely with MONGODB_URI — no separate flag.
#
# Inactive guests are reaped by a MongoDB TTL index this many days after their last
# activity (lastActiveAt is refreshed on every guest request). Tuning knob with a safe
# default of 30 days; lower it to clean up sooner, raise it to keep guests longer.
GUEST_TTL_DAYS=30
# How often (seconds) the background janitor sweeps artifacts left behind by a guest the
# TTL already removed (TTL drops the guest record but can't cascade). Default: one day.
GUEST_PURGE_INTERVAL_SECONDS=86400

# ---- Models ----
# The full set of models offered in the UI's dynamic selector, comma-separated.
# Add/remove freely — the selector, validation and per-tool resolution all update
# automatically with NO code changes. Optionally give an explicit label per entry
# with a pipe ("id|Human Label"); without one, a readable label is derived from
# the id (e.g. "llama-3.3-70b-versatile" → "Llama 3.3 70B Versatile").
AVAILABLE_MODELS=llama-3.3-70b-versatile|Llama 3.3 70B,llama-3.1-8b-instant|Llama 3.1 8B,openai/gpt-oss-120b|GPT-OSS 120B,openai/gpt-oss-20b|GPT-OSS 20B,openai/gpt-oss-safeguard-20b|GPT-OSS Safeguard 20B,qwen/qwen3-32b|Qwen 3 32B,groq/compound|Groq Compound,groq/compound-mini|Groq Compound Mini

# The default model — MUST be one of AVAILABLE_MODELS.
DEFAULT_MODEL=llama-3.3-70b-versatile

# Optional per-tool model overrides. If unset, each tool uses DEFAULT_MODEL. Any
# value set here must ALSO appear in AVAILABLE_MODELS (validated at startup).
# CHAT_MODEL=
# QUIZ_MODEL=
# FLASHCARDS_MODEL=
# PLANNER_MODEL=
# SUMMARY_MODEL=
# Mind maps need only short labels, so a lighter model is a sensible override:
# MINDMAP_MODEL=llama-3.1-8b-instant

# ---- Embeddings ----
# Provider for chat retrieval embeddings:
#   gemini → hosted Google Gemini API (nothing loaded in RAM; needs GEMINI_API_KEY)
#   local  → keyless on-device fastembed model (e.g. BAAI/bge-small-en-v1.5)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_KEY=your-gemini-key-here   # https://aistudio.google.com/apikey
# EMBEDDING_DIM=                       # optional; smaller = smaller index (gemini only)

# ---- Generation tuning (not environment-specific; safe to leave as-is) ----
# Max document text (in tokens) sent to the LLM per generation call. A document
# that fits is sent whole; a larger one uses its first slice — one call either way.
# Keep WELL below your model's tokens-per-minute (TPM) limit: that budget counts the
# input AND the reserved output of each request, so input + prompt + the capped
# completion must fit. 3000 leaves room under Groq's free-tier 6000 TPM (8B model);
# raise it on higher-tier models/plans.
MAX_CONTENT_TOKENS=3000

# ---- Agentic RAG (chat) ----
# When true (default), chat retrieval is an LLM-driven loop: rewrite the question into
# search queries -> retrieve -> grade whether the context is sufficient -> re-retrieve
# with new queries if not -> answer. Set false for classic single-shot top-k RAG.
# Each round costs extra Groq calls; MAX_ITERS bounds the corrective rounds and QUERIES
# bounds how many search queries are tried per round.
AGENTIC_RAG=true
AGENTIC_RAG_MAX_ITERS=2
AGENTIC_RAG_QUERIES=3
