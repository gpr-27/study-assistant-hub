# ─────────────────────────────────────────────────────────────────────────────
# Study Assistant Hub — environment configuration
#
# Copy this file to `.env` and fill in the values. EVERY value the app needs is
# declared here; the code reads NOTHING that is not provided through these
# variables (the single config layer is backend/config.py + frontend/assets/config.js).
#
# Required values have NO in-code fallback — the server refuses to start and prints
# exactly what is missing (e.g. "❌ Missing/invalid configuration: PORT") until set.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Runtime ----
# Environment mode: "development" or "production".
#   development → auto-reload on, verbose logs
#   production  → auto-reload off
# Switching environments requires ONLY changing this value — no code changes.
APP_ENV=development

# Address and port the server binds to. No defaults exist in code — set them here.
HOST=127.0.0.1
PORT=8000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---- Frontend / CORS ----
# The SPA is served by THIS server (same origin), so no CORS is needed and this is
# left empty. If you run the SPA on a different origin (see FRONTEND_PORT below), list the
# allowed origin(s) here, comma-separated, e.g.:
#   CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=

# ---- Split-origin frontend (optional) ----
# By default ONE server serves BOTH the SPA and the API on PORT (same origin, no CORS).
# To run the FRONTEND on its OWN port, set FRONTEND_PORT: `python run.py` then also serves
# the static SPA there, while the browser calls the API cross-origin at API_BASE_URL.
# Leave FRONTEND_PORT blank for classic single-server mode.
#
# When FRONTEND_PORT is set you MUST also set API_BASE_URL (the absolute API URL the browser
# uses) and add the SPA's origin to CORS_ORIGINS above. Example local split setup:
#   PORT=8000
#   FRONTEND_PORT=5173
#   API_BASE_URL=http://127.0.0.1:8000/api
#   CORS_ORIGINS=http://127.0.0.1:5173
FRONTEND_PORT=
API_BASE_URL=

# ---- LLM provider chain (REQUIRED: set AT LEAST ONE of the 5 keys) ----
# Every LLM call goes through backend/llm_chain.py, which tries the steps below in strict
# priority order and uses the first non-empty reply. A blank key skips its step silently;
# the app is valid as long as ANY ONE key is set. Keys are server-side only (never exposed to
# the browser). Calls are time-boxed: 25 s per provider call, 50 s for the whole chain.
#
#   step 1  ANTHROPIC_API_KEY  -> claude-sonnet-5-5                                       (paid)
#   step 2  GROQ_API_KEY       -> openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
#   step 3  GROQ_API_KEY_2     -> same three models (a second Groq org = a second quota)
#   step 4  GEMINI_API_KEY     -> gemini-3.8-flash, gemini-3.6-flash, gemini-3.1-flash-lite
#   step 5  GEMINI_API_KEY_2   -> same three models (a second Google project = a second quota)
#
# Privacy: Gemini's free tier may train on prompts, so requests flagged sensitive skip the
# Gemini steps entirely. Gemini keys must be restricted "auth keys" from AI Studio.
#
# LLM_PROVIDER is optional and informational ("chain" is the default; legacy "groq" is accepted).
LLM_PROVIDER=chain
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
# https://aistudio.google.com/apikey  (also used for embeddings, see below)
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# ---- Auth (optional, Clerk) ----
# Leave BLANK to run the app open (no sign-in). Set a Clerk Publishable Key to put
# a beautiful sign-in gate in front of the app — after signing in, the full Study
# Assistant Hub appears. The publishable key is PUBLIC (safe in the browser); the SPA
# reads it via GET /api/config. Get one at https://dashboard.clerk.com/last-active?path=api-keys
CLERK_PUBLISHABLE_KEY=
# Optional: reserved for backend API session-token verification (defense-in-depth).
# Without it, the gate is client-side only. Keep this SECRET — never expose it.
CLERK_SECRET_KEY=

# ---- Grading integrity (optional) ----
# HMAC key that signs generated quiz/exam questions so a graded attempt can be verified against the server's
# answer key (unverified attempts are still graded but are not counted in Analytics). Generate with
# `python -c "import secrets; print(secrets.token_hex(32))"`. Blank = derived from CLERK_SECRET_KEY / MONGODB_URI.
GRADING_SECRET=

# ---- Persistence (optional, MongoDB) ----
# Leave BLANK to run without history (the app works exactly the same, nothing saved).
# Set a MongoDB connection string to save & browse every chat, quiz, flashcard deck,
# study plan and mind map. History is scoped per user: when Clerk auth is on, each
# signed-in user only sees their own items; without Clerk, everything is stored under
# a single "local" profile. Keep this SECRET (it contains DB credentials).
MONGODB_URI=
# Database name to use inside the cluster (created automatically on first write).
MONGODB_DB_NAME=study_assistant_hub

# ---- Guest accounts (anonymous) ----
# When MongoDB persistence is on AND a Clerk key is set, the sign-in gate also offers
# "Continue as guest": an anonymous, MongoDB-backed session whose chats, quizzes,
# flashcards, plans and mind maps are saved just like a signed-in user's. If the guest
# later signs in/up with Clerk, all their data is migrated to that account automatically.
# Guests need a database, so this turns on/off purely with MONGODB_URI — no separate flag.
#
# Inactive guests are reaped by a MongoDB TTL index this many days after their last
# activity (lastActiveAt is refreshed on every guest request). Tuning knob with a safe
# default of 30 days; lower it to clean up sooner, raise it to keep guests longer.
GUEST_TTL_DAYS=30
# How often (seconds) the background janitor sweeps artifacts left behind by a guest the
# TTL already removed (TTL drops the guest record but can't cascade). Default: one day.
GUEST_PURGE_INTERVAL_SECONDS=86400

# ---- Models (optional) ----
# The LLM chain above chooses the model automatically ("auto: best available via chain") and
# every answer is labelled with the model that produced it. AVAILABLE_MODELS / DEFAULT_MODEL and
# the per-tool *_MODEL overrides are legacy UI hints: leave them BLANK unless you need them.
# If set, DEFAULT_MODEL must be one of AVAILABLE_MODELS (entries: "id" or "id|Human Label").
AVAILABLE_MODELS=
DEFAULT_MODEL=
# CHAT_MODEL=
# QUIZ_MODEL=
# FLASHCARDS_MODEL=
# PLANNER_MODEL=
# SUMMARY_MODEL=
# MINDMAP_MODEL=

# ---- Embeddings ----
# Provider for chat retrieval embeddings:
#   gemini → hosted Google Gemini API (nothing loaded in RAM; needs GEMINI_API_KEY or _2)
#   local  → keyless on-device fastembed model (e.g. BAAI/bge-small-en-v1.5)
# Both are optional: they default to gemini / gemini-embedding-2 when blank or unset.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
# Embedding calls use GEMINI_API_KEY then GEMINI_API_KEY_2 (set in the chain section above),
# rotating when one key's quota is exhausted (same model, so search indexes stay compatible).
# Embeddings are NOT part of the 7-model chat chain.
# EMBEDDING_DIM=                       # optional; smaller = smaller index (gemini only)

# ---- Prompt input / output budgets (handled INSIDE backend/llm_chain.py, per provider) ----
# Callers send the FULL content; there is no product input limit. Groq's free tier (8,000 TPM) needs the
# prompt shrunk, so Groq attempts get a trimmed COPY (largest block middle-out, marked "[...trimmed...]").
GROQ_MAX_INPUT_TOKENS=5500
# Anthropic/Gemini: NOT product limits - provider hard context windows, used only as a backstop to avoid
# a 400. 0 disables the backstop.
ANTHROPIC_MAX_INPUT_TOKENS=190000
GEMINI_MAX_INPUT_TOKENS=900000
# The Anthropic Messages API REQUIRES max_tokens, so "no output cap" = always send the model's maximum
# output allowance and IGNORE the caller's max_tokens on the Anthropic step. Groq/Gemini still honour
# (and clamp) the caller's value.
ANTHROPIC_MAX_OUTPUT_TOKENS=64000
# MAX_CONTENT_TOKENS is deprecated and ignored.

# ---- Spend guards on the PAID Anthropic step (backend/spend.py) ----
# Tokens = prompt + completion, counted per UTC day from the providers' ACTUAL usage. 0 = unlimited.
# When a budget is used up the chain SKIPS Anthropic (skipped: "anthropic budget") and the free Groq/Gemini
# steps answer, so the app keeps working with a different "Model:" label. Counted in Mongo collection
# usage_daily (or in Redis when CACHE_BACKEND is shared); a store failure fails OPEN (per-instance counters).
ANTHROPIC_DAILY_TOKEN_BUDGET=0
ANTHROPIC_OWNER_DAILY_TOKENS=0
ANTHROPIC_GUEST_DAILY_TOKENS=0
# Estimated input tokens per request for the paid step; bigger prompts skip Anthropic ("anthropic too-large")
# and go to Groq (trimmed) / Gemini (not for uploaded content). If nothing else may take it: HTTP 413.
ANTHROPIC_MAX_REQUEST_INPUT_TOKENS=0

# ---- Agentic RAG (chat) ----
# When true (default), chat retrieval is an LLM-driven loop: rewrite the question into
# search queries -> retrieve -> grade whether the context is sufficient -> re-retrieve
# with new queries if not -> answer. Set false for classic single-shot top-k RAG.
# Each round costs extra Groq calls; MAX_ITERS bounds the corrective rounds and QUERIES
# bounds how many search queries are tried per round.
AGENTIC_RAG=true
AGENTIC_RAG_MAX_ITERS=2
AGENTIC_RAG_QUERIES=3

# Vercel Cron auth (set any long random string; Vercel sends it as Authorization: Bearer)
CRON_SECRET=

# ---- Production secrets (Vercel fails CLOSED without them) ----
# SESSION_SECRET signs chat session tokens (random 32+ bytes: `openssl rand -hex 32`). On Vercel the
# app refuses chat sessions (503) rather than deriving a key from provider keys. Optional locally.
SESSION_SECRET=
# On Vercel, a missing CLERK_PUBLISHABLE_KEY makes every authenticated route answer 503 (and
# /api/health/deep reports it) instead of letting all visitors share the single "local" owner.

# ---- Abuse / spend control ----
# Per-owner, per-instance token-bucket limits on the paid (LLM) endpoints: chat, quiz, flashcards,
# exam, cheatsheet, mindmap, planner, predictor, teach-back, scan-notes, insights, overview.
# Over the limit -> 429 JSON + Retry-After. 0 disables that window. Pair with the Vercel Firewall
# rate-limit rules in DEPLOYMENT.md (those are enforced at the edge for ALL instances).
RATE_LIMIT_USER_PER_MIN=30
RATE_LIMIT_USER_PER_HOUR=300
RATE_LIMIT_GUEST_PER_MIN=10
RATE_LIMIT_GUEST_PER_HOUR=60
# Load tests / local dev ONLY (scripts/loadtest.py sets it for its own server). Ignored when VERCEL is set.
# RATE_LIMIT_DISABLED=1

# ---- Privacy: user-uploaded content vs. Gemini's free tier ----
# Gemini's free tier may train on prompts. By default (0) anything built from content a USER uploaded
# (scan-notes photos, user-uploaded subjects, one-off uploaded PDFs, PDF chats) is sent with
# sensitive=True, so the chain skips the Gemini steps (and answers 503 with a clear message if only
# Gemini keys exist). Set to 1 to let Gemini see user content. Bundled sample subjects and generic
# topic-only requests are never affected. Note: retrieval EMBEDDINGS of uploaded PDFs still use Gemini.
ALLOW_GEMINI_FOR_USER_CONTENT=0

# ---- Limits and caches ----
# Seconds one request may use in total on Vercel (maxDuration is 60): chat-tool turns and photo scans
# share it. MAX_BODY_BYTES caps upload bodies (Vercel rejects > 4.5 MB with a non-JSON error).
# TMP_CACHE_MAX_MB caps the per-instance /tmp caches (hydrated PDFs + indexes; LRU eviction).
REQUEST_BUDGET_S=50
MAX_BODY_BYTES=4400000
# Add-a-Subject limits (defaults shown; UPLOAD_MAX_TOTAL_MB=0 / PAGES_PER_REQUEST=0 mean unlimited). The SPA copy is
# generated from these. RAW_KEEP_MB: PDFs above it keep only their text index once read (Atlas M0 is 512 MB total).
# STORAGE_*: uploads get HTTP 507 when the shared database is >= STORAGE_REFUSE_PCT of STORAGE_CAP_MB.
UPLOAD_MAX_FILE_MB=200
UPLOAD_MAX_TOTAL_MB=0
UPLOAD_MAX_FILES=50
UPLOAD_MAX_PDFS_PER_SUBJECT=100
UPLOAD_MAX_SUBJECTS_PER_OWNER=100
UPLOAD_MAX_PAGES_PER_PDF=2000
UPLOAD_MAX_PAGES_PER_REQUEST=0
UPLOAD_MAX_OPEN=8
UPLOAD_MAX_PENDING_MB=1024
RAW_KEEP_MB=25
STORAGE_CAP_MB=512
STORAGE_REFUSE_PCT=90
TMP_CACHE_MAX_MB=300
