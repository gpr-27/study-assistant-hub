# Keep the build context small and the image clean. The Dockerfile only COPYs
# backend/, frontend/, documents/, faiss_index/, requirements.txt,
# gunicorn.conf.py and docker-entrypoint.sh — everything else here is excluded.

# Virtualenv & Python caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Git / CI / editor / OS cruft
.git/
.github/
.gitignore
.idea/
.vscode/
*.swp
.DS_Store
**/.DS_Store

# Claude Code local tooling
.claude/

# Secrets & local env — NEVER bake any env file into the image
.env
.env.*

# Pre-baked FAISS indexes for the bundled subjects ARE included (the Dockerfile
# COPYs faiss_index/ so the server LOADS them instead of re-embedding via Gemini
# on every boot). Only local user-subject indexes are excluded — in production
# those live in MongoDB GridFS and are restored at startup.
faiss_index/user__*/

# Not needed inside the runtime image
tests/
.screens/
*.md
run.py
frontend_server.py
requirements-dev.txt
docker-compose.yml
Dockerfile
.dockerignore
