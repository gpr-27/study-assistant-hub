# ─────────────────────────────────────────────────────────────────────────────
# Study Assistant Hub — PRODUCTION environment template
#
# Copy to `.env` (which docker-compose reads) and fill in the SECRET values.
# This template differs from `.env.example` only in its production defaults:
#   APP_ENV=production, HOST=0.0.0.0, no auto-reload. See `.env.example` for the
#   full prose documentation of every variable.
#
# DO NOT commit a filled-in `.env` — it is gitignored. In a managed platform
# (Render / Railway / Fly.io / Cloud Run / …) set these as the platform's
# environment variables / secrets instead of shipping a file.
#
# NOTE: when you run via docker-compose, APP_ENV / HOST / PORT / WEB_CONCURRENCY
# are already forced to production values by docker-compose.yml, so you mainly
# need the secrets (at least one LLM key, optionally MONGODB_URI + Clerk keys) here.
#
# VERCEL: set the same variables in Project Settings -> Environment Variables. HOST / PORT /
# WEB_CONCURRENCY are ignored there (and APP_ENV defaults to production).
# ─────────────────────────────────────────────────────────────────────────────

# ---- Runtime ----
APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Worker processes (Gunicorn; container deploys only — ignored on Vercel).
WEB_CONCURRENCY=2

# ---- Frontend / CORS ----
# Single-server mode (recommended in containers): the app serves the SPA and API
# on the same origin, so no CORS is needed. Leave empty unless you front the SPA
# from a different origin (e.g. a CDN), in which case list that origin here.
CORS_ORIGINS=

# Split-origin mode is a development convenience and is NOT used inside the
# container image (it serves both on one port). Leave these blank in production.
FRONTEND_PORT=
API_BASE_URL=

# ---- LLM provider chain (REQUIRED: set AT LEAST ONE of the 5 keys; all SECRET) ----
# Every LLM call goes through backend/llm_chain.py, which tries the steps below in strict
# priority order and uses the first non-empty reply. A blank key skips its step silently;
# the app is valid as long as ANY ONE key is set. Keys are server-side only (never exposed to
# the browser). Calls are time-boxed: 25 s per provider call, 50 s for the whole chain.
#
#   step 1  ANTHROPIC_API_KEY  -> claude-sonnet-5-5                                       (paid)
#   step 2  GROQ_API_KEY       -> openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
#   step 3  GROQ_API_KEY_2     -> same three models (a second Groq org = a second quota)
#   step 4  GEMINI_API_KEY     -> gemini-3.8-flash, gemini-3.6-flash, gemini-3.1-flash-lite
#   step 5  GEMINI_API_KEY_2   -> same three models (a second Google project = a second quota)
#
# Privacy: Gemini's free tier may train on prompts, so requests flagged sensitive skip the
# Gemini steps entirely. Gemini keys must be restricted "auth keys" from AI Studio.
#
# LLM_PROVIDER is optional and informational ("chain" is the default; legacy "groq" is accepted).
LLM_PROVIDER=chain
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
# https://aistudio.google.com/apikey  (also used for embeddings, see below)
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# ---- Auth (optional, Clerk) ----
# Leave blank to run open. Set a publishable key (pk_live_… in production) to put
# the sign-in gate in front of the app. For real per-user isolation enforced by
# the API, ALSO set CLERK_SECRET_KEY (backend verifies Clerk session JWTs).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Persistence (optional, MongoDB) ----
# Leave blank for no history. In production prefer a managed cluster (Atlas) or
# the bundled `mongo` compose service (MONGODB_URI=mongodb://mongo:27017). SECRET.
MONGODB_URI=
MONGODB_DB_NAME=study_assistant_hub

# ---- Guest accounts (anonymous) ----
GUEST_TTL_DAYS=30
GUEST_PURGE_INTERVAL_SECONDS=86400

# ---- Models (optional, legacy UI hints) ----
# The chain picks the model ("auto: best available via chain"); leave these blank.
AVAILABLE_MODELS=
DEFAULT_MODEL=

# ---- Embeddings (hosted Gemini REST; not part of the 7-model chat chain) ----
# Uses GEMINI_API_KEY then GEMINI_API_KEY_2 from the chain section above.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# ---- Prompt input / output budgets (handled INSIDE backend/llm_chain.py, per provider) ----
# Callers send the FULL content; there is no product input limit. Groq's free tier (8,000 TPM) needs the
# prompt shrunk, so Groq attempts get a trimmed COPY (largest block middle-out, marked "[...trimmed...]").
GROQ_MAX_INPUT_TOKENS=5500
# Anthropic/Gemini: NOT product limits - provider hard context windows, used only as a backstop to avoid
# a 400. 0 disables the backstop.
ANTHROPIC_MAX_INPUT_TOKENS=190000
GEMINI_MAX_INPUT_TOKENS=900000
# The Anthropic Messages API REQUIRES max_tokens, so "no output cap" = always send the model's maximum
# output allowance and IGNORE the caller's max_tokens on the Anthropic step. Groq/Gemini still honour
# (and clamp) the caller's value.
ANTHROPIC_MAX_OUTPUT_TOKENS=64000
# MAX_CONTENT_TOKENS is deprecated and ignored.

# ---- Agentic RAG (chat) ----
# LLM-driven retrieval loop (rewrite -> retrieve -> grade -> correct). Set false for
# classic single-shot RAG. Each round costs extra LLM calls; keep MAX_ITERS small on
# the free tier to stay under rate limits.
AGENTIC_RAG=true
AGENTIC_RAG_MAX_ITERS=2
AGENTIC_RAG_QUERIES=3
